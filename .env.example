# Which provider to use for the chat LLM and for embeddings/retrieval.
# Each can be set independently to "openai", "gemini", or "ollama".
CHAT_PROVIDER=openai
EMBEDDING_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Gemini ---
# GATEWAY_GEMINI_UPSTREAM_KEY is also accepted as a fallback if GEMINI_API_KEY is unset.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# --- Ollama (local, no API key needed) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
# Must be a multilingual embedding model -- the ordinance is Hebrew, and an
# English-only model (e.g. nomic-embed-text) silently produces near-random
# retrieval instead of an error.
OLLAMA_EMBEDDING_MODEL=bge-m3

# --- Retrieval tuning ---
RETRIEVAL_K=4

# --- Embedding indexing ---
# Lower these for a rate-limited free-tier embedding API (e.g. Gemini free
# tier); the defaults suit a local Ollama server with no such limits.
EMBEDDING_BATCH_SIZE=100
EMBEDDING_REQUEST_DELAY_SECONDS=0
